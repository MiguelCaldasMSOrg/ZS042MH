{
  "tasks": [
    {
      "args": [
        "compile",
        "--fqbn",
        "${input:microbitFqbn}",
        "--warnings",
        "all",
        "--library",
        ".",
        "${input:examplePath}"
      ],
      "command": "arduino-cli",
      "group": {
        "isDefault": true,
        "kind": "build"
      },
      "label": "Arduino: Compile Example",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "type": "process"
    },
    {
      "args": [
        "compile",
        "--fqbn",
        "${input:microbitFqbn}",
        "--warnings",
        "all",
        "--upload",
        "--port",
        "${input:microbitPort}",
        "--library",
        ".",
        "${input:examplePath}"
      ],
      "command": "arduino-cli",
      "label": "Arduino: Compile and Upload Example",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "type": "process"
    },
    {
      "args": [
        "compile",
        "--fqbn",
        "${input:microbitFqbn}",
        "--build-path",
        ".build",
        "--only-compilation-database",
        "--library",
        ".",
        "${input:examplePath}"
      ],
      "command": "arduino-cli",
      "label": "Arduino: Refresh Compilation Database",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "type": "process"
    }
  ],
  "inputs": [
    {
      "default": "sandeepmistry:nRF5:BBCmicrobitV2",
      "description": "BBC micro:bit board",
      "id": "microbitFqbn",
      "options": [
        "sandeepmistry:nRF5:BBCmicrobit",
        "sandeepmistry:nRF5:BBCmicrobitV2"
      ],
      "type": "pickString"
    },
    {
      "default": "examples/ReadWriteTime",
      "description": "Example sketch directory",
      "id": "examplePath",
      "type": "promptString"
    },
    {
      "default": "COM3",
      "description": "BBC micro:bit USB serial port",
      "id": "microbitPort",
      "type": "promptString"
    }
  ],
  "version": "2.0.0"
}